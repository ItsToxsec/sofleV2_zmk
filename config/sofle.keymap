#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
//#include <dt-bindings/zmk/pointing.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/rgb.h>

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT

// #define BASE    0
// #define GAM     1
// #define NUM     2
// #define SYM     3
// #define NAV     4
// #define MED     5
// #define FUN     6 

#define BASE    0
#define GAL     1
#define COL     2
#define GAM     3
#define NUM     4
#define FUN     5
#define NAV     6
#define MED     7

/ {
    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };

        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        gt: gaming_tap {
            label = "gaming_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <250>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    combos {
        compatible = "zmk,combos";

        combo_lshft {
            bindings = <&kp LSHFT>;
            key-positions = <42 43>;
            layers = <0 1 2>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <14 15>;
            layers = <0 1 2>;
        };

        combo_rshft {
            bindings = <&kp RSHFT>;
            key-positions = <46 47>;
            layers = <0 1 2>;
        };

        combo_dash {
            bindings = <&kp MINUS>;
            key-positions = <23 24>;
            layers = <0 1 2>;
        };

        combo_lsuper {
            bindings = <&kp LGUI>;
            key-positions = <40 41>;
            layers = <0 1 2>;
        };

        combo_rsuper {
            bindings = <&kp RGUI>;
            key-positions = <50 49>;
            layers = <0 1 2>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <59 57>;
            layers = <0 1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp N1      &kp N2      &kp N3       &kp N4        &kp N5         &kp UP_ARROW     &kp N6       &kp N7         &kp N8       &kp N9      &kp N0         &kp MINUS
&kp EQUAL   &kp Q       &kp W       &kp E        &kp R         &kp T          &kp DOWN_ARROW   &kp Y        &kp U          &kp I        &kp O       &kp P          &kp BSLH
&kp TAB     &ht LGUI A  &ht LALT S  &ht LCTRL D  &ht LSHFT F   &kp G          &kp LEFT_ARROW   &kp H        &ht RSHFT J    &ht RCTRL K  &ht RALT L  &ht RGUI SEMI  &kp SQT
&kp LPAR    &kp Z       &kp X       &kp C        &kp V         &kp B          &kp RIGHT_ARROW  &kp N        &kp M          &kp COMMA    &kp DOT     &kp FSLH       &kp RPAR
&kp C_MUTE  &kp HOME    &kp LEFT    &kp RIGHT    &lt MED BSPC  &lt FUN DEL    &kp DELETE       &lt NUM RET  &lt NAV SPACE  &kp UP       &kp DOWN    &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Main";
        };

        gal_layer {
            bindings = <
&kp EQUAL   &kp N1      &kp N2      &kp N3       &kp N4        &kp N5         &kp UP_ARROW     &kp N6       &kp N7         &kp N8       &kp N9      &kp N0      &kp MINUS
&kp ESC     &kp X       &kp M       &kp W        &kp G         &kp Q          &kp DOWN_ARROW   &kp K        &kp F          &kp O        &kp U       &kp MINUS   &kp BSLH
&kp TAB     &ht LGUI N  &ht LALT R  &ht LCTRL T  &ht LSHFT S   &kp V          &kp LEFT_ARROW   &kp P        &ht RSHFT H    &ht RCTRL A  &ht RALT E  &ht RGUI I  &kp SQT
&kp LPAR    &kp B       &kp L       &kp D        &kp C         &kp J          &kp RIGHT_ARROW  &kp Z        &kp Y          &kp COMMA    &kp DOT     &kp SEMI    &kp RPAR
&kp C_MUTE  &kp HOME    &kp LEFT    &kp RIGHT    &lt MED BSPC  &lt FUN DEL    &kp DELETE       &lt NUM RET  &lt NAV SPACE  &kp UP       &kp DOWN    &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Gallium";
        };

        col_layer {
            bindings = <
&kp EQUAL   &kp N1      &kp N2      &kp N3       &kp N4        &kp N5         &kp UP_ARROW     &kp N6       &kp N7         &kp N8       &kp N9      &kp N0      &kp MINUS
&kp ESC     &kp Q       &kp W       &kp F        &kp P         &kp B          &kp DOWN_ARROW   &kp J        &kp L          &kp U        &kp Y       &kp SEMI    &kp BSLH
&kp TAB     &ht LGUI A  &ht LALT R  &ht LCTRL S  &ht LSHFT T   &kp G          &kp LEFT_ARROW   &kp M        &ht RSHFT N    &ht RCTRL E  &ht RALT I  &ht RGUI O  &kp SQT
&kp LPAR    &kp Z       &kp X       &kp C        &kp D         &kp V          &kp RIGHT_ARROW  &kp K        &kp H          &kp COMMA    &kp DOT     &kp FSLH    &kp RPAR
&kp C_MUTE  &kp HOME    &kp LEFT    &kp RIGHT    &lt MED BSPC  &lt FUN DEL    &kp DELETE       &lt NUM RET  &lt NAV SPACE  &kp UP       &kp DOWN    &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Colemak";
        };

        gam_layer {
            bindings = <
&kp ESC     &kp N7    &kp N1  &kp N2  &kp N3     &kp N4       &kp UP_ARROW     &kp N6       &kp N7         &kp N8       &kp N9      &kp N0         &kp MINUS
&kp H       &kp T     &kp Q   &kp W   &kp E      &gt TAB R    &kp DOWN_ARROW   &kp Y        &kp U          &kp I        &kp O       &kp P          &kp BSLH
&kp L       &kp M     &kp A   &kp S   &kp D      &kp F        &kp LEFT_ARROW   &kp H        &ht RSHFT J    &ht RCTRL K  &ht RALT L  &ht RGUI SEMI  &kp SQT
&kp GRAVE   &kp B     &kp Z   &kp X   &kp C      &kp V        &kp RIGHT_ARROW  &kp N        &kp M          &kp COMMA    &kp DOT     &kp FSLH       &kp RPAR
&kp C_MUTE  &kp CAPS  &kp N5  &kp N6  &kp LSHFT  &kp LCTRL    &kp DELETE       &to BASE     &lt SYM SPACE  &kp UP       &kp DOWN    &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Gaming";
        };

        num_layer {
            bindings = <
&none       &none      &none      &none      &none      &none        &kp UP_ARROW     &none     &none      &none      &none      &none     &none
&none       &kp BSLH   &kp SQT    &kp LBKT   &kp LBRC   &kp LPAR     &kp DOWN_ARROW   &kp RPAR   &kp RBRC  &kp RBKT   &kp GRAVE  &kp EQUAL &none
&none       &kp N1     &kp N2     &kp N3     &kp N4     &kp N5       &kp LEFT_ARROW   &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &none
&none       &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp RIGHT_ARROW  &kp CARET  &kp AMPS  &kp ASTRK  &kp MINUS  &kp UNDER &none
&kp C_MUTE  &none      &none      &none      &kp LSHFT  &kp LALT     &kp DELETE       &trans     &none   &none   &none   &none
            >;

            display-name = "Number";
            sensor-bindings = <&scroll_encoder>;
        };

        fun_layer {
            bindings = <
&none      &none    &none   &none   &none   &none      &mmv MOVE_UP     &none     &none    &none   &none   &none   &none
&none       &kp F21 &kp F22 &kp F23 &kp F24 &none      &mmv MOVE_DOWN   &none     &none    &none   &none   &none   &none
&none       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &mmv MOVE_LEFT   &kp F6    &kp F7   &kp F8  &kp F9  &kp F10 &none
&none       &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &mmv MOVE_RIGHT  &kp F16   &kp F17  &kp F18 &kp F19 &kp F20 &none
&kp C_MUTE  &none   &none   &none   &none   &none      &mkp LCLK        &none     &none    &none   &none   &none
            >;

            display-name = "Functions";
            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            bindings = <
&none  &none  &none  &none  &none  &none        &mmv MOVE_UP     &none      &none     &none     &none      &none  &none
&none  &none  &none  &none  &none  &none        &mmv MOVE_DOWN   &none      &none     &kp UP    &none      &none  &none
&none  &none  &none  &none  &none  &kp PG_UP    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&none  &none  &none  &none  &none  &kp HOME     &mmv MOVE_RIGHT  &kp END    &none     &none     &none      &none  &none
&none  &none  &none  &none  &none  &trans       &mkp LCLK        &kp TAB    &none     &none     &none      &none
            >;

            display-name = "Navigation";
            sensor-bindings = <&scroll_encoder>;
        };

        med_layer {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &none            &none           &none            &none            &none            &none
&none  &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none           &mmv MOVE_DOWN   &none            &to GAL         &to BASE         &to COL          &none            &none
&none  &out OUT_USB  &out OUT_BLE    &none         &none         &none           &mmv MOVE_LEFT   &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &none
&none  &sys_reset    &none           &bootloader   &none         &none           &mmv MOVE_RIGHT  &none            &none           &sys_reset       &soft_off        &bootloader      &none
&none  &none         &none           &none         &none         &none           &mkp LCLK        &to GAM          &none           &none            &none            &none
            >;

            display-name = "Media";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
